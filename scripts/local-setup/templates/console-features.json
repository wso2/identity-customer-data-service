{
  "_comment": [
    "Console feature blocks for the Customer Data section, used only by the",
    "compatibility fallback in lib/patch_console_template.py: a pack whose",
    "bundled Console already knows the cds_host key configures all of this",
    "through deployment.toml instead, and this file is never touched.",
    "Each entry becomes one feature under 'features' in the Console's",
    "deployment.config.json.j2, alongside the cdsHost extension key."
  ],
  "customerDataService": {
    "create": [],
    "delete": [],
    "feature": ["console:customerData"],
    "read": ["internal_cds_admin_config_view"],
    "update": ["internal_cds_admin_config_update", "internal_cds_profile_update"]
  },
  "customerDataProfiles": {
    "create": ["internal_cds_profile_create"],
    "delete": ["internal_cds_profile_delete"],
    "feature": ["console:customerData"],
    "read": ["internal_cds_admin_config_view", "internal_cds_profile_view"],
    "update": ["internal_cds_admin_config_update", "internal_cds_profile_update"]
  },
  "customerDataProfileAttributes": {
    "create": ["internal_cds_profile_schema_create"],
    "delete": ["internal_cds_profile_schema_delete"],
    "feature": ["console:customerData"],
    "read": ["internal_cds_profile_schema_view", "internal_cds_profile_view"],
    "update": ["internal_cds_profile_schema_update", "internal_cds_profile_update"]
  },
  "customerDataUnificationRules": {
    "create": ["internal_cds_unification_rule_create"],
    "delete": ["internal_cds_unification_rule_delete"],
    "feature": ["console:customerData"],
    "read": ["internal_cds_admin_config_view", "internal_cds_unification_rule_view"],
    "update": ["internal_cds_admin_config_update", "internal_cds_unification_rule_update"]
  }
}
